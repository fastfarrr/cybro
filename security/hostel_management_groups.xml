<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record model="ir.module.category"
                id="module_category_hostel_management">
            <field name="name">Hostel</field>
            <!--            <field name="sequence">5</field>-->
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_hostel">
            <field name="name">Hostel Management</field>
            <field name="category_id"
                   ref="hostel_management.module_category_hostel_management"/>
        </record>

        <record id="group_student_user" model="res.groups">
            <field name="name">Student</field>
            <field name="privilege_id" ref="res_groups_privilege_hostel"/>
            <field name="implied_ids" eval="[(4,ref('base.group_user'))]"/>
        </record>

        <record id="group_staff_user" model="res.groups">
            <field name="name">Staff</field>
            <field name="privilege_id" ref="res_groups_privilege_hostel"/>
            <field name="implied_ids" eval="[(4,ref('base.group_user'))]"/>
        </record>

        <record id="group_warden_user" model="res.groups">
            <field name="name">Warden</field>
            <field name="privilege_id" ref="res_groups_privilege_hostel"/>
            <field name="user_ids"
                   eval="[(4,ref('base.user_root')),(4,ref('base.user_admin'))]"/>
        </record>

        


    </data>
</odoo>