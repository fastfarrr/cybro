<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="student_leave_request_view" model="ir.ui.view">
        <field name="name">Leave Report</field>
        <field name="model">leave.request.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="room_ids" widget="many2many_tags"/>
                        <field name="student_ids" widget="many2many_tags"/>
                        <field name="start_date"/>
                        <field name="arrival_date"/>
                    </group>
                </sheet>
                <footer>
                    <button class="btn-primary"
                            name="generate_report_pdf"
                            string="generate PDF"
                            type="object"
                            icon="fa-print"/>
                </footer>
            </form>
        </field>

    </record>
    <record id="student_leave_request_action" model="ir.actions.act_window">
        <field name="name">Leave Request Report</field>
        <field name="res_model">leave.request.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>