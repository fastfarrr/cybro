<?xml version = "1.0" encoding="UTF-8" ?>
<odoo>
    <template id="student_report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Student Report</h2>
                </div>
                <div>
                        <t t-if="room_number">Rooms:<t t-foreach="data" t-as="room">,<span t-esc="room['room_number']"/></t></t>
                        <t t-else="room_number['False']">Rooms:<t t-foreach="data" t-as="new">,<span t-esc="new['room_number']"/></t></t>
                </div>
                <div>
                    <t t-if="student_name">Student:<t t-foreach="data" t-as="student">,<span t-esc="student['student_name']"/></t></t>
                    <t t-else="student_name['False']">Students:<t t-foreach="data" t-as="new">,<span t-esc="new['student_name']"/></t></t>
                </div>

                <table class="table">
                    <thead>
                        <tr>
                            <th>SL.No</th>
                            <th>Name</th>
                            <th>Pending Amount</th>
                            <th>Room</th>
                            <th>Invoice Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="data" t-as="student">
                            <tr>
                                <td>
                                    <span t-esc="student_index"/>
                                </td>
                                <td>
                                    <span t-esc="student['student_name']"/>
                                </td>
                                <td>
                                    <span t-esc="student['pending_amount']"/>
                                </td>
                                <td>
                                    <span t-esc="student['room_number']"/>
                                </td>
                                <td>
                                    <span t-esc="student['invoice_status']"/>
                                </td>

                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
        </t>
    </template>
</odoo>
