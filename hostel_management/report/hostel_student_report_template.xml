<?xml version = "1.0" encoding="UTF-8" ?>
<odoo>
    <template id="student_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Student Report</h2>
                    </div>
                    <table class="table">
                        <thead>
                        <tr>
                            <th>SL.No</th>
                            <th>Name</th>
                            <th>Pending Amount</th>
                            <th>Room</th>
                            <th>Invoice Status</th>
                        </tr>
                        </thead>

                        <t t-foreach="o.student_id" t-as="student">
                        <tr>
                            <td><span t-esc = "student.id"/></td>
                            <td><span t-esc = "student.student_name"/></td>
                            <td><span t-esc = "student.room_id.pending_amount"/></td>
                            <td><span t-esc = "student.room_id.room_number"/></td>
                            <td><span t-esc = "student.invoice_status"/> </td>
                        </tr>
                        </t>

                    </table>
                </t>
            </t>
        </t>
    </template>
</odoo>