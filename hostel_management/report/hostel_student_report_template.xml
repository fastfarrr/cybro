<?xml version = "1.0" encoding="UTF-8" ?>
<odoo>
    <template id="student_report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Student Report</h2>
                </div>
<!--                <div>-->
<!--                    <h2><span t-esc="data[student_name]"/></h2>-->

<!--                </div>-->
                <table class="table">
                    <thead>
                        <tr>
                            <th>SL.No</th>
                            <th>Name</th>
                            <th>Pending Amount</th>
                            <th>Room</th>
                            <th>Invoice Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="data" t-as="student">
                            <tr>
                                <td><span t-esc="student_index"/></td>
                                <td><span t-esc="student['student_name']"/></td>
                                <td><span t-esc="student['pending_amount']"/></td>
                                <td><span t-esc="student['room_number']"/></td>
                                <td><span t-esc="student['invoice_status']"/> </td>

                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
        </t>
    </template>
</odoo>
