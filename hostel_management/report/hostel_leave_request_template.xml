<?xml version = "1.0" encoding="UTF-8" ?>
<odoo>
    <template id="leave_report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Leave Report</h2>
                </div>
                <div>
                    <t t-if="student_name">Student:
                        <t t-foreach="student_name" t-as="student">
                            <t t-if="not student_first">,</t>
                            <span t-esc="student.student_name"/>
                        </t>
                    </t>


                </div>

                <div>
                    <t t-if="room_number">Rooms:
                        <t t-foreach="room_number" t-as="room">
                            <t t-if="not room_first">,</t>
                            <span t-esc="room.room_number"/>
                        </t>
                    </t>

                </div>

                <div>
                    <t t-if="start_date">Start Date:
                        <t t-foreach="data" t-as="start">
                            <t t-if="not start_first">,</t>
                            <span t-esc="start['leave_date']"/>
                        </t>
                    </t>

                </div>

                <div>
                    <t t-if="arrival_date">Arrival Date:
                        <t t-foreach="data" t-as="arrival">
                            <t t-if="not arrival_first">,</t>
                            <span t-esc="arrival['arrival_date']"/>
                        </t>
                    </t>


                </div>
                <table class="table">
                    <thead>
                        <tr>
                            <th>SL No</th>
                            <th>Student</th>
                            <th>Room</th>
                            <th>Start Date</th>
                            <th>Arrival Date</th>
                            <th>Duration</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="data" t-as="leave">
                            <tr>
                                <td>
                                    <span t-esc="leave_index +1"/>
                                </td>
                                <td>
                                    <span t-esc="leave['student_name']"/>
                                </td>
                                <td>
                                    <span t-esc="leave['room_number']"/>
                                </td>
                                <td>
                                    <span t-esc="leave['leave_date']"/>
                                </td>
                                <td>
                                    <span t-esc="leave['arrival_date']"/>
                                </td>
                                <td>
                                    <span t-esc="leave['duration']"/>
                                </td>

                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
        </t>
    </template>
</odoo>