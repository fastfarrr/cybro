<?xml version = "1.0" encoding="UTF-8" ?>
<odoo>
    <template id="leave_report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Student Report</h2>
                </div>
                <table class="table">
                    <thead>
                        <tr>
                            <th>SL No</th>
                            <th>Student</th>
                            <th>Room</th>
                            <th>Start Date</th>
                            <th>Arrival Date</th>
                            <th>Duration</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="data" t-as="leave">
                            <tr>
                                <td><span t-esc="leave_index"/> </td>
                                <td><span t-esc="leave['student_name']"/></td>
                                <td><span t-esc="leave['room_number']"/></td>
                                <td><span t-esc="leave['leave_date']"/></td>
                                <td><span t-esc="leave['arrival_date']"/> </td>

                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
        </t>
    </template>
</odoo>