<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.module.category"
            id="module_category_restrict_product_creation">
        <field name="name">Restrict Product Creation</field>
    </record>

    <record model="res.groups.privilege"
            id="res_groups_privilege_restrict_product">
        <field name="name">Restrict Product Creation</field>
        <field name="category_id"
               ref="restrict_product_creation.module_category_restrict_product_creation"/>
    </record>

    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id"
               ref="res_groups_privilege_restrict_product"/>
        <field name="implied_ids" eval="[(4,ref('base.group_user'))]"/>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id"
               ref="res_groups_privilege_restrict_product"/>
        <field name="implied_ids" eval="[(4,ref('group_user'))]"/>
        <field name="user_ids"
               eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>