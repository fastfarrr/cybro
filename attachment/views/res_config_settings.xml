<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_setting_attachment_form_view" model="ir.ui.view">
        <field name="name">Purchase order attachment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">

            <xpath expr="//app[@name='purchase']" position="inside">
                <block title="Purchase Custom">
                    <setting string="Mandatory attachment" id="attachment"
                             help="To make sure the purchase order have an file attached">
                        <field name="is_file_attached"/>
                    </setting>
                </block>
            </xpath>
        </field>

    </record>
</odoo>