<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form_discount_limit"
            model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale.testing
        </field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//app[@name='sale_management']//block[@id='pricing_setting_container']"
                   position='inside'>
                <setting id="limit" help="To set max discount limit for a month" string="Discount Limit" company_dependent="1">
                    <field name="limit"/>

                    <div class="content-group" invisible='not limit'>
                        <div class="mt16">
                        <field name="discount_limit" />
                        </div>
                    </div>


                </setting>

            </xpath>
        </field>

    </record>
</odoo>