<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form_discount_limit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale.testing</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//app[@name='sale_management']//block[@id='pricing_setting_container']" position='inside'>
                    <setting string="Discount limit" help="to set max discount limit for a month">
                        <field name="discount_limit"/>
                    </setting>

            </xpath>
        </field>

    </record>
</odoo>